# [모듈] api/.env.example
# [담당] 공통
# [역할] 필요한 환경변수 목록. 값은 비워둠(로컬에서 채울 것).
# [TODO] 구현 필요

# --- DB ---
DB_WRITER_URL=                     # writer(master) MySQL 접속 URL
DB_READER_URL=                     # reader(replica) MySQL 접속 URL. 개발 중엔 writer와 동일 주소 가능
DB_POOL_SIZE=                      # SQLAlchemy 커넥션 풀 크기
DB_POOL_RECYCLE=3600               # 커넥션 재활용 주기(초)

# --- Valkey ---
VALKEY_MASTER_HOST=                # 쓰기/Lua 전용
VALKEY_MASTER_PORT=
VALKEY_REPLICA_HOST=               # 읽기 전용
VALKEY_REPLICA_PORT=

# --- JWT ---
JWT_SECRET=                        # 서명 시크릿
JWT_ACCESS_EXPIRE_MIN=             # access 토큰 만료(분)
JWT_REFRESH_EXPIRE_DAYS=           # refresh 토큰 만료(일)

# --- 예매 ---
HOLD_TTL_SEC=                      # 좌석 선점 유지 시간(초)

# --- 대기열 ---
QUEUE_ENABLED=true                 # false면 entryTicket 검증 없이 통과(우회 플래그)
QUEUE_DISPATCH_BATCH_SIZE=         # 방출 인원 (dispatcher가 한 주기에 내보낼 인원)
QUEUE_POLL_INTERVAL_SEC=3          # 클라이언트 폴링 권장 주기(초). 롱폴링 금지

# --- 인스턴스 ---
INSTANCE_ID=                       # 로그 구분용 (api-a / api-c)
