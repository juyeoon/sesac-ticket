# [모듈] api/.env.example
# [담당] 공통
# [역할] 필요한 환경변수 목록. 값은 비워둠(로컬에서 채울 것).

# --- DB ---
DB_WRITER_URL=                     # writer(master) MySQL 접속 URL
DB_READER_URL=                     # reader(replica) MySQL 접속 URL. 개발 중엔 writer와 동일 주소 가능
DB_POOL_SIZE=5                     # SQLAlchemy 커넥션 풀 크기
DB_POOL_RECYCLE=3600               # 커넥션 재활용 주기(초)

# --- Valkey ---
VALKEY_MASTER_HOST=                # 쓰기/Lua 전용
VALKEY_MASTER_PORT=6379
VALKEY_REPLICA_HOST=               # 읽기 전용. 개발 중엔 master와 동일 주소 가능
VALKEY_REPLICA_PORT=6379

# --- JWT ---
JWT_SECRET=                        # 서명 시크릿
JWT_ACCESS_EXPIRE_MIN=30           # access 토큰 만료(분)
JWT_REFRESH_EXPIRE_DAYS=14         # refresh 토큰 만료(일)

# --- 예매 ---
HOLD_TTL_SEC=300                   # 좌석 선점 유지 시간(초)

# --- 대기열 ---
QUEUE_ENABLED=true                 # false면 entryTicket 검증 없이 통과(우회 플래그)
QUEUE_DISPATCH_BATCH_SIZE=50       # 방출 인원 (dispatcher가 한 주기에 내보낼 인원)
QUEUE_POLL_INTERVAL_SEC=3          # 클라이언트 폴링 권장 주기(초). 롱폴링 금지
QUEUE_TOKEN_TTL_SEC=1800           # queueToken 유효시간(초)

# --- 인증 부가 기능 (비밀번호 재설정 / 이메일 인증) ---
PASSWORD_RESET_TTL_SEC=900         # 재설정 토큰 유효시간(초)
EMAIL_VERIFICATION_TTL_SEC=600     # 인증 코드 유효시간(초)
EMAIL_VERIFICATION_COOLDOWN_SEC=60 # 재요청 쿨다운(초)

# --- 이메일 발송 (SMTP) ---
SMTP_HOST=                         # 비워두면 실제 발송 없이 로그만 남김 (로컬/테스트 기본값)
SMTP_PORT=587
SMTP_USERNAME=                     # 예: SES/Gmail 앱 비밀번호 계정 등
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@sesac-ticket.local
SMTP_FROM_NAME=새싹티켓

# --- 인프라 ---
TRUSTED_PROXY_HOSTS=*              # ProxyHeadersMiddleware 신뢰 호스트. 운영에서는 nginx 내부 IP로 제한
COOKIE_SECURE=true                 # refreshToken 쿠키 Secure 플래그. 로컬 http 개발 시 false로

# --- 앱/API 버전 (SYS-003) ---
API_VERSION=1.0.0                  # 서버가 지원하는 API 버전
APP_LATEST_VERSION=1.0.0           # 최신 앱(서비스) 버전
APP_MIN_REQUIRED_VERSION=1.0.0     # 강제 업데이트 기준 최소 버전
APP_FORCE_UPDATE=false
APP_UPDATE_URL=                    # 강제 업데이트 안내 URL

# --- 인스턴스 ---
INSTANCE_ID=api-local              # 로그 구분용 (api-a / api-c)
